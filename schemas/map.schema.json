{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Map",
  "type": "object",
  "required": ["schema_version", "kind", "id", "name", "player_spawn", "rooms", "enemy"],
  "properties": {
    "schema_version": { "type": "integer", "const": 1 },
    "kind": { "type": "string", "const": "map" },
    "id": { "type": "string", "minLength": 1 },
    "name": { "type": "string", "minLength": 1 },
    "builder": { "type": "string", "minLength": 1, "default": "slice" },
    "player_spawn": { "type": "array", "items": { "type": "number" }, "minItems": 3, "maxItems": 3 },
    "starting_points": { "type": "integer", "minimum": 0 },
    "enemy": { "type": "string" },
    "zombie_count": { "type": "integer", "minimum": 1 },
    "rooms": { "type": "array", "minItems": 1 },
    "doors": { "type": "array" },
    "barricades": { "type": "array" },
    "zombie_spawns": { "type": "array" }
  }
}
